generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  role               String              // "ADMIN" | "HOD" | "TEACHER" | "STUDENT"
  firstName          String
  lastName           String
  phone              String?
  departmentScopeId  String?             // For HOD / Teachers assigned to a specific department
  isActive           Boolean             @default(true)
  mustChangePassword Boolean             @default(false)
  invitationToken    String?             @unique
  resetToken         String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  facultyProfile     FacultyProfile?
  studentProfile     StudentProfile?
  auditEvents        AuditEvent[]
  notifications      Notification[]
  createdMeetings    Meeting[]           @relation("MeetingCreator")
  authoredNotes      MeetingNote[]       @relation("NoteAuthor")
  assignedMentors    MentorAssignment[]  @relation("AssignedByAdmin")
  importJobs         ImportJob[]
}

model Department {
  id             String           @id @default(cuid())
  code           String           @unique // "CSE", "ISE", "ECE", "CIVIL", "MECH", "AI_DS", etc.
  name           String
  description    String?
  intakeCapacity Int              @default(120)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  programmes     Programme[]
  faculty        FacultyProfile[]
  students       StudentProfile[]
  importJobs     ImportJob[]
}

model Programme {
  id             String           @id @default(cuid())
  departmentId   String
  code           String           @unique // "BTECH_CSE", "BTECH_ISE", "MTECH_CSE", "MCA"
  name           String
  degreeLevel    String           // "UG", "PG", "PHD"
  durationYears  Int              @default(4)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  department     Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students       StudentProfile[]
  batchSections  BatchSection[]
}

model AcademicYear {
  id             String           @id @default(cuid())
  name           String           @unique // "2024-2025", "2025-2026", "2026-2027"
  isCurrent      Boolean          @default(false)
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime         @default(now())

  batchSections  BatchSection[]
  progressions   StudentProgression[]
}

model BatchSection {
  id             String           @id @default(cuid())
  programmeId    String
  academicYearId String
  admissionYear  Int              // e.g. 2023, 2024
  semester       Int              // 1 to 8
  sectionName    String           // "A", "B", "C", "D"
  capacity       Int              @default(60)
  createdAt      DateTime         @default(now())

  programme      Programme        @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([programmeId, academicYearId, semester, sectionName])
}

model FacultyProfile {
  id                 String             @id @default(cuid())
  userId             String?            @unique // Nullable until login account is approved/activated
  stagingRefId       String?            @unique // e.g., "FAC52", "FAC62" from official nitte.edu.in
  employeeCode       String             @unique
  prefix             String?            // "Dr.", "Prof.", "Mr.", "Ms."
  fullName           String
  designation        String             // "Principal & Professor", "Professor & Head", "Associate Professor", etc.
  departmentId       String
  officialProfileUrl String?            // Source URL on nitte.edu.in
  photoUrl           String?
  approvalStatus     String             @default("STAGED") // "STAGED", "APPROVED", "REJECTED", "ARCHIVED"
  isVerified         Boolean            @default(true)
  verifiedAt         DateTime?
  verifiedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  department         Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  mentorAssignments  MentorAssignment[]
  appointmentRequests AppointmentRequest[]
}

model StudentProfile {
  id                  String             @id @default(cuid())
  userId              String?            @unique // Nullable until student portal account invited/activated
  institutionalId     String             @unique // USN or NDU Registration No (e.g., 4NM22CS001, NNM23CS012)
  fullName            String
  institutionalEmail  String?            @unique
  departmentId        String
  programmeId         String
  admissionYear       Int
  currentSemester     Int
  section             String             // "A", "B", "C"
  admissionCategory   String             @default("REGULAR") // "REGULAR", "LATERAL_ENTRY", "NRI", "MANAGEMENT"
  enrolmentStatus     String             @default("ACTIVE")  // "ACTIVE", "GRADUATED", "DETAINED", "TRANSFERRED"
  approvalStatus      String             @default("APPROVED") // "PENDING_APPROVAL", "APPROVED", "REJECTED"
  createdByTeacherId  String?            // If added by a teacher
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  department          Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  programme           Programme          @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  progressions        StudentProgression[]
  mentorAssignments   MentorAssignment[]
  meetingParticipants MeetingParticipant[]
  actionItems         ActionItem[]
  appointmentRequests AppointmentRequest[]
}

model StudentProgression {
  id                     String        @id @default(cuid())
  studentId              String
  academicYearId         String
  semester               Int
  section                String
  sgpa                   Float?
  cgpa                   Float?
  attendancePercentage   Float?
  attendanceShortageFlag Boolean       @default(false)
  pcmPercentagePUC       Float?        // Specific to NMAMIT mentoring criteria (<65% flagged for FA)
  remarks                String?
  recordedAt             DateTime      @default(now())

  student                StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear           AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, semester])
}

model MentorAssignment {
  id                 String         @id @default(cuid())
  studentId          String
  mentorFacultyId    String
  roleType           String         @default("CLASS_PROCTOR") // "CLASS_PROCTOR" | "FACULTY_ADVISOR"
  status             String         @default("ACTIVE")        // "ACTIVE" | "TRANSFERRED" | "ENDED"
  effectiveStartDate DateTime       @default(now())
  effectiveEndDate   DateTime?
  reassignmentReason String?
  assignedById       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorFaculty      FacultyProfile @relation(fields: [mentorFacultyId], references: [id], onDelete: Cascade)
  assignedBy         User?          @relation("AssignedByAdmin", fields: [assignedById], references: [id], onDelete: SetNull)
}

model Meeting {
  id                 String               @id @default(cuid())
  title              String
  description        String?
  sessionType        String               @default("ONE_ON_ONE") // "ONE_ON_ONE" | "GROUP"
  agendaCategory     String               @default("ACADEMIC_PERFORMANCE") // "ACADEMIC_PERFORMANCE", "ATTENDANCE_SHORTAGE", "MSE1_REVIEW", "CAREER_AND_INTERNSHIP", "PERSONAL_WELLBEING"
  scheduledAt        DateTime             // Asia/Kolkata ISO timestamp
  durationMinutes    Int                  @default(30)
  locationOrLink     String               @default("Department Mentor Chamber")
  status             String               @default("CONFIRMED") // "REQUESTED", "CONFIRMED", "COMPLETED", "CANCELLED", "NO_SHOW"
  createdById        String
  cancellationReason String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  createdBy          User                 @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants       MeetingParticipant[]
  notes              MeetingNote[]
  actionItems        ActionItem[]
}

model MeetingParticipant {
  id                 String         @id @default(cuid())
  meetingId          String
  studentId          String
  attendanceStatus   String         @default("PRESENT") // "PRESENT", "ABSENT", "EXCUSED"
  feedbackNotes      String?
  createdAt          DateTime       @default(now())

  meeting            Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([meetingId, studentId])
}

model MeetingNote {
  id                 String         @id @default(cuid())
  meetingId          String
  authorId           String
  visibilityLevel    String         // "STUDENT_VISIBLE" | "MENTOR_ONLY" | "RESTRICTED_COUNSELLING"
  noteContent        String
  revisionHistoryJson String?       // Array of previous revisions with timestamps
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  meeting            Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author             User           @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
}

model ActionItem {
  id                 String         @id @default(cuid())
  studentId          String
  meetingId          String?
  title              String
  description        String?
  assignedToRole     String         @default("STUDENT") // "STUDENT" | "MENTOR"
  priority           String         @default("MEDIUM")  // "LOW", "MEDIUM", "HIGH", "URGENT"
  status             String         @default("OPEN")    // "OPEN", "IN_PROGRESS", "COMPLETED", "OVERDUE"
  dueDate            DateTime
  completedAt        DateTime?
  outcomeNotes       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  meeting            Meeting?       @relation(fields: [meetingId], references: [id], onDelete: SetNull)
}

model AppointmentRequest {
  id                 String         @id @default(cuid())
  studentId          String
  mentorFacultyId    String
  requestedDate      DateTime
  preferredTimeSlot  String         // e.g. "10:30 AM - 11:00 AM"
  agenda             String
  status             String         @default("PENDING") // "PENDING", "APPROVED", "DECLINED"
  responseRemarks    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorFaculty      FacultyProfile @relation(fields: [mentorFacultyId], references: [id], onDelete: Cascade)
}

model Notification {
  id                 String         @id @default(cuid())
  userId             String
  title              String
  message            String
  linkUrl            String?
  isRead             Boolean        @default(false)
  createdAt          DateTime       @default(now())

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ImportJob {
  id                 String          @id @default(cuid())
  importedById       String
  fileName           String
  fileType           String          // "CSV" | "XLSX"
  departmentId       String
  totalRows          Int             @default(0)
  successfulRows     Int             @default(0)
  failedRows         Int             @default(0)
  status             String          @default("PROCESSING") // "PROCESSING", "COMPLETED", "FAILED"
  createdAt          DateTime        @default(now())

  importedBy         User            @relation(fields: [importedById], references: [id], onDelete: Cascade)
  department         Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  rowErrors          ImportRowError[]
}

model ImportRowError {
  id                 String          @id @default(cuid())
  importJobId        String
  rowNumber          Int
  rawDataJson        String
  fieldName          String?
  errorMessage       String

  importJob          ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id                 String          @id @default(cuid())
  actorId            String?
  actorEmail         String?
  actorRole          String?
  action             String          // "STUDENT_CREATED", "BULK_IMPORT", "MENTOR_ASSIGNED", "NOTE_CREATED", "LOGIN_SUCCESS", "LOGIN_FAILED", "STAGING_APPROVED"
  entityType         String          // "Student", "Faculty", "Meeting", "Assignment", "User"
  entityId           String?
  ipAddress          String?
  userAgent          String?
  detailsJson        String?
  timestamp          DateTime        @default(now())

  actor              User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model SourceVerificationRecord {
  id                 String          @id @default(cuid())
  entityType         String          // "INSTITUTION", "DEPARTMENT", "FACULTY", "MENTORING_POLICY"
  entityIdentifier   String          // e.g. "FAC52", "DEPT_CSE", "MENTORING_SCHEME"
  verifiedField      String          // e.g. "DESIGNATION", "NAME", "PROCTOR_STRUCTURE"
  verifiedValue      String
  sourceUrl          String
  verifiedDate       DateTime        @default(now())
  verifiedBy         String          @default("RESEARCH_AUDITOR")
  verificationStatus String          @default("VERIFIED") // "VERIFIED", "CONFLICT_FLAGGED", "UNRESOLVED"
  conflictNotes      String?
}

model InstitutionalSetting {
  id                 String          @id @default(cuid())
  settingKey         String          @unique // e.g. "STUDENT_ID_LABEL", "MAX_MENTEES_PER_MENTOR", "PROCTOR_CAPACITY", "DEFAULT_TIMEZONE"
  settingValue       String
  description        String?
  isEditable         Boolean         @default(true)
  updatedAt          DateTime        @updatedAt
}
